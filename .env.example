APP_ENV=development
APP_NAME=LibriHub
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
BACKEND_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=

POSTGRES_DB=librihub
POSTGRES_USER=librihub
POSTGRES_PASSWORD=librihub_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://librihub:librihub_password@postgres:5432/librihub

MINIO_ROOT_USER=librihub_minio
MINIO_ROOT_PASSWORD=librihub_minio_password
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_BUCKET_BOOK_COVERS=book-covers

JWT_SECRET_KEY=change-me-in-local-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

LIBRIHUB_ADMIN_EMAIL=admin@librihub.local
LIBRIHUB_ADMIN_PASSWORD=
LIBRIHUB_ADMIN_FULL_NAME=LibriHub Admin
LIBRIHUB_ADMIN_PHONE=0999999999
LIBRIHUB_ADMIN_LEVEL=GLOBAL
